# Modèle de configuration de l'appli du garage moto.
# Pour l'utiliser, il faut copier ce fichier en ".env" puis changer les valeurs selon le garage.

# J'ai mis le port d'entrée ici pour pouvoir le changer si un autre logiciel du garage utilise déjà le 8080.
NGINX_PORT=8080

# J'ai mis le port interne du front et de l'API ici pour n'avoir à le changer qu'à un seul endroit,
# il est ensuite passé au front, à l'API et à Nginx (qui doit savoir où les joindre).
APP_PORT=3000

# J'ai mis le mode ici pour pouvoir passer en "development" si je dois corriger un bug, sans reconstruire les images :
# en "production" le front et l'API sont silencieux, en "development" ils affichent chaque requête dans les logs
# (docker compose logs -f front back).
NODE_ENV=production

# J'ai mis le temps d'arrêt ici : après SIGTERM, Docker attend ce temps avant de tuer le conteneur (SIGKILL).
# Le front, l'API, Nginx et l'autoscaler quittent en moins d'une seconde, donc 5 s est une marge (Docker met 10 s par défaut).
STOP_GRACE_PERIOD=5s

# J'ai mis les limites CPU et RAM ici pour pouvoir les adapter si le garage a un PC d'atelier plus petit ou plus gros.
# J'ai choisi ces valeurs après mes benchmarks (voir README), avec 10 mécaniciens en même temps il n'y a eu aucune erreur.
# Avec 0.25 CPU par conteneur l'appli fait plus de 1000 requêtes/s, c'est bien plus que ce dont un garage a besoin.
# Au total les 3 conteneurs utilisent au maximum 0.75 cœur, donc moins d'un cœur du PC de l'atelier.
# Pour la RAM j'ai mis environ 2 fois le pic mesuré, pour garder de la marge sans gaspiller la mémoire du PC.
FRONT_CPUS=0.25
# Le front a eu un pic à 45 Mo (mesuré quand il était lancé avec npm start), donc 64 Mo.
FRONT_MEM=64m
BACK_CPUS=0.25
# L'API a eu un pic à 14 Mo, donc 32 Mo.
BACK_MEM=32m
NGINX_CPUS=0.25
# Nginx a eu un pic à 12 Mo, donc 32 Mo.
NGINX_MEM=32m

# J'ai mis les limites du conteneur de lint ici aussi : eslint (Node) prend plus de ressources que l'appli, mais seulement
# quelques secondes quand on lance "docker compose run --rm lint".
LINT_CPUS=0.5
LINT_MEM=256m

# ---- Docker Swarm et autoscaler (seulement avec deploy-swarm.bat, docker compose ne s'en sert pas) ----
# J'ai mis le nombre de copies min et max ici pour pouvoir l'adapter à la taille du PC de l'atelier :
# avec 4 copies à 0.25 CPU, le front, l'API et Nginx prennent au maximum 1 cœur chacun.
MIN_REPLICAS=1
MAX_REPLICAS=4
# Les seuils sont en % de la limite CPU d'un conteneur : au-dessus de CPU_HAUT j'ajoute une copie,
# en dessous de CPU_BAS j'en enlève une.
CPU_HAUT=80
CPU_BAS=20
# Le temps entre deux mesures, et le temps d'attente après un changement (en secondes).
INTERVALLE=15
COOLDOWN=60
# Les services que l'autoscaler peut multiplier (séparés par un espace).
AUTOSCALE_SERVICES=front back serveur-web
# Les limites de l'autoscaler lui-même : il lance seulement quelques commandes docker toutes les 15 s, donc très peu.
AUTOSCALER_CPUS=0.10
AUTOSCALER_MEM=32m
